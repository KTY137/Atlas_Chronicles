# Copy to deploy/.env (git-ignored) or generate it: node deploy/configure-selfhost.mjs <domain>
# --- Reachability -----------------------------------------------------------
# The public origin players open. Passkeys need https + a real domain (spike-B N1-N6).
# http://<LAN-IP> carries the app, but that is the OPEN P11 topology: cookie fallback only.
CHRONICLE_ORIGIN=https://chronik.example.org
CHRONICLE_DOMAIN=chronik.example.org
# --- Secrets (never commit; generate with the script above) ------------------
POSTGRES_PASSWORD=
COOKIE_SECRET=
BOOTSTRAP_TOKEN=
# --- Media layer (compose profile "media"; leave all four LIVEKIT_* empty to run without voice)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://livekit.chronik.example.org
LIVEKIT_API_URL=http://livekit:7880
TURN_SECRET=
# The address players reach the SFU/TURN on (needed for ICE candidates behind NAT).
PUBLIC_IP=
