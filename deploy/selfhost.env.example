# Copy to deploy/.env (git-ignored) or generate it: node deploy/configure-selfhost.mjs <domain>
# --- Reachability -----------------------------------------------------------
# The public origin players open. Passkeys need https + a real domain (spike-B N1-N6).
# HTTP on a private LAN IP requires CHRONICLE_INSECURE_LAN=1; see docs/LAN.md.
CHRONICLE_ORIGIN=https://chronik.example.org
CHRONICLE_DOMAIN=chronik.example.org
CHRONICLE_INSECURE_LAN=0
# --- Secrets (never commit; generate with the script above) ------------------
POSTGRES_PASSWORD=
COOKIE_SECRET=
BOOTSTRAP_TOKEN=
