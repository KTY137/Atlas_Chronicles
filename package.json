{
  "name": "chronicle",
  "private": true,
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "author": "Kaya Yesilyurt",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "configure": "tsx packages/server/src/main.ts --configure",
    "campaign-bundle": "tsx packages/server/src/bundle-cli.ts",
    "db:up": "docker compose --env-file .local/postgres.env -f deploy/docker-compose.dev.yml up -d --wait",
    "start": "tsx packages/server/src/main.ts",
    "media:configure": "node deploy/media/prepare-local.mjs",
    "media:up": "docker compose -f deploy/media/compose.yaml up -d",
    "media:check": "node deploy/media/check-local.mjs",
    "start:media": "node --env-file=deploy/media/.runtime/app.env --import tsx packages/server/src/main.ts",
    "dev:media": "node --env-file=deploy/media/.runtime/app.env tools/dev.mjs",
    "dev": "node tools/dev.mjs",
    "build": "npm run build --workspace @chronicle/client",
    "desktop:build": "node packages/desktop/tools/build.mjs",
    "desktop": "npm run desktop:build && node packages/desktop/tools/launch.mjs",
    "desktop:smoke": "npm run desktop:build && node packages/desktop/tools/smoke.mjs",
    "desktop:installer": "node packages/desktop/tools/installer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "gate:version": "node --test tools/test/gate-version.test.mjs && node tools/gate-version.mjs",
    "gate:boundaries": "node tools/gate-boundaries.mjs",
    "gate:assets": "node --import tsx --test tools/test/gate-assets-binary.test.mjs tools/test/importiere-fremdpaket.test.mjs && node --import tsx tools/gate-assets.mjs",
    "assets:erzeugen": "node tools/assets/erzeuge-grundrisspaket.mjs && node tools/assets/erzeuge-atlaspaket.mjs && node tools/assets/erzeuge-gemaltpaket.mjs",
    "gate": "npm run gate:version && npm run gate:boundaries && npm run gate:assets && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "nanoid": ">=3.3.18"
  }
}
