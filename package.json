{
  "name": "chronicle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:boundaries": "node tools/gate-boundaries.mjs",
    "gate": "npm run gate:boundaries && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "nanoid": ">=3.3.18"
  }
}
