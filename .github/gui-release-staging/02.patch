+// Actual native dropdown input on the installed Electron surface, not selectOption injection.
+async function nativeChoice(control,value){
+  const values=await control.locator("option").evaluateAll(options=>options.filter(o=>!o.disabled).map(o=>o.value));
+  const index=values.indexOf(value);assert.ok(index>=0,`Missing enabled option ${value}`);
+  await control.click();await control.press("Home");
+  for(let i=0;i<index;i++)await control.press("ArrowDown");
+  await control.press("Enter");assert.equal(await control.inputValue(),value);
+}
